---
import {neon} from '@neondatabase/serverless';
import {drizzle} from 'drizzle-orm/neon-http';
import {posts} from '../../db/schema.ts';
import "../../styles/global.css";
const sql = neon(import.meta.env.DATABASE_URL);

const dateOptions: object = {
    year: "numeric",
    month: "long",
    day: "numeric",
};

function formatDate(date:string){
    return new Date(date).toLocaleDateString("en-US", dateOptions);
}

const db = drizzle({client: sql});
const records = await db.select().from(posts);
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Title</title>
</head>
<body class="bg-zinc-900">
<div class="text-white">
    <div class="flex justify-center items-center">
        <div class="grid grid-cols-1 gap-4 w-1/2">
            {
                records.map((data) =>
                        <div class="bg-neutral-800 rounded-lg shadow-md p-4">
                            <div>
                                <div>{data.title}</div>
                                <div>{formatDate(data.created_on)}</div>
                            </div>
                            <div>{data.post}</div>
                            <div>
                                <button class="rounded-md bg-neutral-800 p-2.5 border border-transparent text-center text-sm text-red-600 transition-all shadow-sm hover:shadow-lg focus:bg-neutral-800 focus:shadow-none active:bg-neutral-800 hover:bg-neutral-800 active:shadow-none disabled:pointer-events-none disabled:opacity-50 disabled:shadow-none" type="button">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                                    <path d="m11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z" />
                                </svg>
                                </button>
                                {data.likes}
                            </div>

                        </div>
                )
            }
        </div>
    </div>
</div>
</body>
</html>

