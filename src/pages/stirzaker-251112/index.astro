---
export const prerender = false
import "../../styles/global.css";
import {actions} from "astro:actions";

let result = Astro.getActionResult(actions.register);
result = result ? result : {"state": "failure"}
if (result.state === "success") {
    return Astro.redirect(`/thankyou`);
}
---

<html lang="en">
<head>
    <meta charset="utf-8"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="generator" content={Astro.generator}/>
    <title>Family Storybook Registration</title>
</head>
<body class="h-screen flex justify-center items-center bg-[#F2F4F7] text-[#333333] text-lg">
<div class="flex flex-col items-center border-black">
    <h1 class="py-5 text-[#0866FF] text-5xl font-bold font-[Source Sans Pro]">Family Storybook</h1>

    <div class="border-2 border-gray-50 bg-white rounded-md shadow-2xl p-10">
        <div class="flex justify-center w-100">
            <label class="text-black text-3xl">Registration</label>
        </div>
        <form method="POST" action={actions.register} autocomplete="off">
            <div class="py-10">
                <div class="">
                    <!--<label for="familyName">Family Name <span class="text-red-600">&nbsp*</span></label>-->
                    <input class="w-100 border rounded-md border-[#CCD0D5] bg-white p-2" type="text" id="yourFamilyName" placeholder="Your Family Name" name="yourFamilyName"/>
                </div>
            </div>
            <div class="py-1">
                <div class="">
                    <!--<label for="emailAddress">Email Address<span class="text-red-600">&nbsp*</span></label>-->
                    <input class="w-100 border rounded-md border-[#CCD0D5] bg-white p-2" type="email" id="emailAddress" placeholder="Email Address" name="emailAddress" />
                </div>
            </div>
            <div class="py-2.5">
                <div class="w-100">
                    <label  for="privacyStatement">By registering you agree with how your data is collected as defined in the following <br/><a href="/stirzaker-251112/privacy">Privacy Statement</a></label>
                </div>
            </div>

            <div class="py-1">
                <div class="flow-root">
                    <button class="w-30 float-left ml-10 rounded-md bg-[#00A400] py-1 px-2 text-white" type="submit"
                            id="button">
                        Subscribe
                    </button>
                    <button class="w-30 float-right mr-10 rounded-md bg-[#3B3D3E] py-1 px-2 text-white" type="reset"
                            id="button">
                        Cancel
                    </button>
                </div>
            </div>

        </form>
    </div>
</div>
</body>
</html>
