---
export const prerender = false
import "../styles/global.css";
import {actions} from "astro:actions";
---

<html lang="en">
<head>
    <meta charset="utf-8"/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="generator" content={Astro.generator}/>
    <title>Family Storybook Registration</title>
</head>
<body class="h-screen flex justify-center items-center bg-[#F2F4F7] text-[#333333] text-lg">
<div class="flex flex-col items-center border-black">
    <h1>Family Storybook - Register</h1>
    <div class="border-l-black">
        <form method="POST" action={actions.register}>
            <div class="py-10">
                <div class="">
                    <!--<label for="familyName">Family Name <span class="text-red-600">&nbsp*</span></label>-->
                    <input class="w-100 border rounded-md border-[#DDDFE2] bg-white p-2" type="text" id="familyName" placeholder="Family Name" name="familyName"/>
                </div>
            </div>
            <div class="py-1">
                <div class="">
                    <!--<label for="emailAddress">Email Address<span class="text-red-600">&nbsp*</span></label>-->
                    <input class="w-100 border rounded-md border-[#DDDFE2] bg-white p-2" type="email" id="emailAddress" placeholder="Email Address" name="emailAddress"/>
                </div>
            </div>
            <div class="py-1">
                <div class="flow-root w-75">
                    <input  type="checkbox" id="privacyStatement" name="privacyStatement" value="FALSE"/>
                    <label  for="privacyStatement">I agree with <a href="">Privacy Statement</a></label>
                </div>
            </div>
            <div class="py-1">
                <div class="flow-root">
                    <button class="w-30 float-left ml-10 rounded-md bg-[#0866FF] py-1 px-2 text-white" type="submit"
                            id="button">
                        Subscribe
                    </button>
                    <button class="w-30 float-right mr-10 rounded-md bg-[#3B3D3E] py-1 px-2 text-white" type="reset"
                            id="button">
                        Cancel
                    </button>
                </div>
            </div>

        </form>
    </div>
</div>
</body>
</html>
